{
  "name": "nymrel-swarm-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Private, fixture-driven reference interface for exploring multi-agent workspace and review patterns.",
  "type": "module",
  "license": "MIT",
  "author": "Nymrel <contact@nymrel.com>",
  "homepage": "https://nymrel.com/products/swarm-studio",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.12 <27",
    "npm": ">=11.5 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test scripts vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "truth:check": "node scripts/verify-static-truth.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "audit:ci": "npm audit --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run truth:check && npm run build && npm run bundle:check"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
